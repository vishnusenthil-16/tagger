# Documentation template only. Tagger does not auto-load dotenv files.
# Inject real keys with your environment/secret manager; do not commit them.
TAGGER_BACKEND=jev
TAGGER_BACKEND_BASE_URL=https://api.typesafe.ai
TAGGER_BACKEND_MODEL=jev-1.14.0
TAGGER_BACKEND_API_KEY=replace-with-backend-key
TAGGER_API_KEY=replace-with-separate-service-client-key
TAGGER_REQUEST_TIMEOUT_SECONDS=30
TAGGER_MAX_REQUEST_BYTES=1048576
TAGGER_MAX_TEXT_BYTES=65536
TAGGER_MAX_CATEGORIES=19
TAGGER_MAX_CATEGORY_DESCRIPTION_BYTES=2048
TAGGER_MAX_CONCURRENT_REQUESTS=1
